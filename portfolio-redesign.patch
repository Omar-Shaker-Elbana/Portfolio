diff --git a/assets/css/style.css b/assets/css/style.css
new file mode 100644
index 0000000..9b890cd
--- /dev/null
+++ b/assets/css/style.css
@@ -0,0 +1,1031 @@
+/* =====================================================================
+   Omar Shaker — Portfolio · shared design system
+   Used by index.html, projects.html and blog.html
+   1. Tokens   2. Base   3. Layout & type   4. Header / menu
+   5. Buttons & chips   6. Cards   7. Reveal motion   8. Utilities
+   ===================================================================== */
+
+/* ─────────────── 1. TOKENS ─────────────── */
+:root {
+  color-scheme: dark;
+
+  --bg: #06050f;
+  --bg-2: #0c0a1b;
+  --bg-3: #131029;
+  --glass: rgb(12 10 27 / 0.72);
+  --surface: rgb(255 255 255 / 0.045);
+  --surface-2: rgb(255 255 255 / 0.08);
+  --line: rgb(255 255 255 / 0.09);
+  --line-2: rgb(255 255 255 / 0.18);
+
+  --text: #f6f4ff;
+  --text-2: #bfbadf;
+  --text-3: #8c87b1;
+
+  --c-cyan: #22d3ee;
+  --c-violet: #8b5cf6;
+  --c-pink: #ff4d8d;
+  --c-lime: #a3e635;
+  --c-amber: #fbbf24;
+  --c-orange: #fb923c;
+  --c-blue: #4f8cff;
+
+  --acc: var(--c-violet);
+  --acc-rgb: 139 92 246;
+
+  --grad: linear-gradient(110deg, var(--c-cyan), var(--c-violet) 48%, var(--c-pink));
+  --grad-warm: linear-gradient(110deg, var(--c-amber), var(--c-pink));
+  --btn-grad: linear-gradient(110deg, #7c3aed, #c026d3 55%, #f43f7a);
+
+  --font-display: "Bricolage Grotesque", "Segoe UI", system-ui, sans-serif;
+  --font-body: "DM Sans", system-ui, -apple-system, "Segoe UI", sans-serif;
+  --font-mono: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
+
+  --r-sm: 10px;
+  --r: 16px;
+  --r-lg: 24px;
+  --r-xl: 32px;
+
+  --ease: cubic-bezier(0.16, 1, 0.3, 1);
+  --spring: cubic-bezier(0.34, 1.56, 0.64, 1);
+
+  --gutter: clamp(1.1rem, 4.5vw, 2.25rem);
+  --section-y: clamp(4.5rem, 10vw, 8.5rem);
+  --maxw: 1200px;
+  --header-h: 76px;
+
+  --shadow: 0 24px 60px -24px rgb(0 0 0 / 0.65);
+  --page-glow: radial-gradient(900px 520px at 8% -6%, rgb(139 92 246 / 0.20), transparent 60%),
+    radial-gradient(760px 520px at 96% 4%, rgb(34 211 238 / 0.13), transparent 60%),
+    radial-gradient(900px 640px at 50% 108%, rgb(255 77 141 / 0.12), transparent 62%);
+}
+
+[data-theme="light"] {
+  color-scheme: light;
+
+  --bg: #faf9ff;
+  --bg-2: #f1eefc;
+  --bg-3: #e8e3fa;
+  --glass: rgb(250 249 255 / 0.78);
+  --surface: rgb(255 255 255 / 0.78);
+  --surface-2: #ffffff;
+  --line: rgb(30 20 80 / 0.1);
+  --line-2: rgb(30 20 80 / 0.2);
+
+  --text: #14102b;
+  --text-2: #453e6a;
+  --text-3: #6a6490;
+
+  --c-cyan: #0891b2;
+  --c-violet: #7c3aed;
+  --c-pink: #db2777;
+  --c-lime: #4d7c0f;
+  --c-amber: #b45309;
+  --c-orange: #c2410c;
+  --c-blue: #2563eb;
+
+  --shadow: 0 24px 50px -26px rgb(60 40 140 / 0.35);
+  --page-glow: radial-gradient(900px 520px at 8% -6%, rgb(124 58 237 / 0.13), transparent 60%),
+    radial-gradient(760px 520px at 96% 4%, rgb(8 145 178 / 0.12), transparent 60%),
+    radial-gradient(900px 640px at 50% 108%, rgb(219 39 119 / 0.09), transparent 62%);
+}
+
+/* accent scopes — set on any section / card to recolour everything inside */
+.acc-violet { --acc: var(--c-violet); --acc-rgb: 139 92 246; }
+.acc-cyan   { --acc: var(--c-cyan);   --acc-rgb: 34 211 238; }
+.acc-pink   { --acc: var(--c-pink);   --acc-rgb: 255 77 141; }
+.acc-lime   { --acc: var(--c-lime);   --acc-rgb: 163 230 53; }
+.acc-amber  { --acc: var(--c-amber);  --acc-rgb: 251 191 36; }
+.acc-orange { --acc: var(--c-orange); --acc-rgb: 251 146 60; }
+.acc-blue   { --acc: var(--c-blue);   --acc-rgb: 79 140 255; }
+
+/* text-safe version of the accent (darkened automatically in light mode) */
+* { --acc-ink: var(--acc); }
+[data-theme="light"] * { --acc-ink: color-mix(in srgb, var(--acc) 62%, #120d2a); }
+
+/* ─────────────── 2. BASE ─────────────── */
+*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
+
+html {
+  scroll-behavior: smooth;
+  -webkit-text-size-adjust: 100%;
+  text-size-adjust: 100%;
+  scroll-padding-top: calc(var(--header-h) + 8px);
+}
+
+body {
+  min-height: 100vh;
+  min-height: 100dvh;
+  background: var(--bg);
+  background-image: var(--page-glow);
+  background-attachment: fixed;
+  color: var(--text-2);
+  font: 400 1rem/1.7 var(--font-body);
+  overflow-x: hidden;
+  overflow-x: clip;
+  -webkit-font-smoothing: antialiased;
+  text-rendering: optimizeLegibility;
+}
+
+img, svg, video, canvas { display: block; max-width: 100%; }
+img { height: auto; }
+a { color: inherit; text-decoration: none; }
+button { font: inherit; color: inherit; background: none; border: 0; cursor: pointer; }
+ul, ol { list-style: none; }
+iframe { border: 0; }
+::selection { background: rgb(var(--acc-rgb) / 0.35); color: var(--text); }
+
+:focus-visible {
+  outline: 2px solid var(--acc);
+  outline-offset: 3px;
+  border-radius: 6px;
+}
+
+::-webkit-scrollbar { width: 10px; height: 10px; }
+::-webkit-scrollbar-track { background: var(--bg); }
+::-webkit-scrollbar-thumb { background: var(--line-2); border-radius: 10px; border: 2px solid var(--bg); }
+::-webkit-scrollbar-thumb:hover { background: var(--c-violet); }
+
+/* theme-switch cross-fade (class is added briefly by JS) */
+.theme-anim, .theme-anim *, .theme-anim *::before, .theme-anim *::after {
+  transition: background-color 0.45s ease, border-color 0.45s ease, color 0.45s ease, fill 0.45s ease !important;
+}
+
+.skip-link {
+  position: fixed; top: -100px; left: 1rem; z-index: 300;
+  padding: 0.7rem 1.1rem; border-radius: var(--r-sm);
+  background: var(--text); color: var(--bg); font-weight: 600;
+  transition: top 0.25s var(--ease);
+}
+.skip-link:focus { top: 1rem; }
+
+/* cross-page fade (progressive enhancement) */
+@view-transition { navigation: auto; }
+::view-transition-old(root) { animation: 0.25s ease both vtOut; }
+::view-transition-new(root) { animation: 0.45s var(--ease) both vtIn; }
+@keyframes vtOut { to { opacity: 0; } }
+@keyframes vtIn { from { opacity: 0; transform: translateY(8px); } }
+
+/* ─────────────── 3. LAYOUT & TYPE ─────────────── */
+.container { width: min(var(--maxw), 100% - 2 * var(--gutter)); margin-inline: auto; }
+
+.section { position: relative; padding-block: var(--section-y); }
+
+h1, h2, h3, h4 {
+  font-family: var(--font-display);
+  color: var(--text);
+  line-height: 1.08;
+  letter-spacing: -0.025em;
+  font-weight: 700;
+  text-wrap: balance;
+}
+p { text-wrap: pretty; }
+strong { color: var(--text); font-weight: 600; }
+
+.eyebrow {
+  display: inline-flex; align-items: center; gap: 0.7rem;
+  font: 500 0.75rem/1 var(--font-mono);
+  letter-spacing: 0.16em; text-transform: uppercase;
+  color: var(--acc-ink);
+}
+.eyebrow::before {
+  content: ""; width: 30px; height: 2px; border-radius: 2px;
+  background: var(--acc);
+  box-shadow: 0 0 14px rgb(var(--acc-rgb) / 0.8);
+  transform-origin: left; transform: scaleX(0);
+  transition: transform 0.9s var(--ease) 0.15s;
+}
+.is-in .eyebrow::before, .eyebrow.is-in::before, .no-js .eyebrow::before { transform: scaleX(1); }
+
+.section-head { margin-bottom: clamp(2.25rem, 5vw, 3.75rem); max-width: 760px; }
+.section-title {
+  font-size: clamp(2.1rem, 5.6vw, 3.9rem);
+  font-weight: 800;
+  margin: 1rem 0 0.9rem;
+}
+.section-sub { font-size: clamp(1rem, 1.6vw, 1.15rem); color: var(--text-2); max-width: 62ch; }
+
+.grad-text {
+  background: var(--grad);
+  background-size: 200% auto;
+  -webkit-background-clip: text; background-clip: text;
+  color: transparent; -webkit-text-fill-color: transparent;
+  animation: gradShift 9s linear infinite;
+}
+@keyframes gradShift { to { background-position: 200% center; } }
+
+.mono { font-family: var(--font-mono); }
+
+/* word-by-word title reveal (words are wrapped by main.js) */
+.w { display: inline-block; overflow: hidden; vertical-align: top; padding-bottom: 0.14em; margin-bottom: -0.14em; }
+.wi { display: inline-block; transform: translateY(110%); transition: transform 0.9s var(--ease); transition-delay: calc(var(--wi, 0) * 60ms + 80ms); }
+.is-in .wi, .no-js .wi { transform: none; }
+
+/* ─────────────── 4. HEADER / NAV / MOBILE MENU ─────────────── */
+.site-header {
+  position: fixed; inset: 0 0 auto 0; z-index: 120;
+  padding-top: max(0.8rem, env(safe-area-inset-top));
+  pointer-events: none;
+}
+.nav-shell {
+  pointer-events: auto;
+  width: calc(100% - 2 * var(--gutter)); max-width: var(--maxw);
+  margin-inline: auto; height: 60px;
+  display: flex; align-items: center; justify-content: space-between; gap: 1rem;
+  padding: 0 0.6rem 0 1.15rem;
+  border: 1px solid transparent; border-radius: 999px;
+  transition: max-width 0.6s var(--ease), background 0.4s, border-color 0.4s, box-shadow 0.4s;
+}
+.site-header.is-scrolled .nav-shell {
+  max-width: 1120px;
+  background: var(--glass);
+  border-color: var(--line);
+  box-shadow: var(--shadow);
+  -webkit-backdrop-filter: blur(18px) saturate(1.5);
+  backdrop-filter: blur(18px) saturate(1.5);
+}
+
+.brand { display: inline-flex; align-items: baseline; font: 800 1.35rem/1 var(--font-display); letter-spacing: -0.04em; color: var(--text); }
+.brand-dot { color: var(--c-pink); transition: transform 0.4s var(--spring); display: inline-block; }
+.brand:hover .brand-dot { transform: translateY(-4px) scale(1.4); }
+
+.nav { position: relative; display: none; }
+.nav-links { display: flex; align-items: center; gap: 0.1rem; position: relative; z-index: 1; }
+.nav-links a {
+  display: block; padding: 0.55rem 0.85rem; border-radius: 999px;
+  font-size: 0.875rem; font-weight: 500; color: var(--text-2);
+  transition: color 0.25s;
+}
+.nav-links a:hover, .nav-links a.is-active, .nav-links a[aria-current="page"] { color: var(--text); }
+.nav-indicator {
+  position: absolute; top: 50%; left: 0; height: 36px; width: 0;
+  transform: translate(0, -50%); border-radius: 999px;
+  background: var(--surface-2); border: 1px solid var(--line);
+  opacity: 0; transition: transform 0.5s var(--ease), width 0.5s var(--ease), opacity 0.3s;
+}
+.nav-indicator.is-on { opacity: 1; }
+
+.nav-actions { display: flex; align-items: center; gap: 0.5rem; }
+.nav-actions .nav-cta { display: none; }
+
+.icon-btn {
+  width: 42px; height: 42px; border-radius: 50%;
+  display: inline-flex; align-items: center; justify-content: center;
+  color: var(--text-2); border: 1px solid var(--line); background: var(--surface);
+  transition: color 0.25s, border-color 0.25s, background 0.25s, transform 0.4s var(--spring);
+}
+.icon-btn:hover { color: var(--text); border-color: var(--line-2); background: var(--surface-2); transform: rotate(14deg) scale(1.06); }
+.icon-btn .ico { width: 18px; height: 18px; }
+.theme-toggle .i-sun { display: none; }
+[data-theme="light"] .theme-toggle .i-sun { display: block; }
+[data-theme="light"] .theme-toggle .i-moon { display: none; }
+
+.menu-btn {
+  width: 44px; height: 42px; border-radius: 999px;
+  display: inline-flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px;
+  border: 1px solid var(--line); background: var(--surface);
+}
+.menu-btn span { width: 18px; height: 2px; border-radius: 2px; background: var(--text); transition: transform 0.4s var(--ease), opacity 0.2s; }
+.menu-btn[aria-expanded="true"] span:nth-child(1) { transform: translateY(4px) rotate(45deg); }
+.menu-btn[aria-expanded="true"] span:nth-child(2) { transform: translateY(-4px) rotate(-45deg); }
+
+.mobile-menu {
+  position: fixed; inset: 0; z-index: 110;
+  display: flex; flex-direction: column; justify-content: center;
+  padding: calc(var(--header-h) + 1rem) var(--gutter) max(2rem, env(safe-area-inset-bottom));
+  background:
+    radial-gradient(600px 400px at 90% 10%, rgb(139 92 246 / 0.35), transparent 60%),
+    radial-gradient(500px 400px at 0% 100%, rgb(255 77 141 / 0.25), transparent 60%),
+    var(--bg);
+  overflow-y: auto;
+  clip-path: circle(0px at calc(100% - 3rem) 2.2rem);
+  visibility: hidden;
+  transition: clip-path 0.7s var(--ease), visibility 0s 0.7s;
+}
+.mobile-menu.is-open { clip-path: circle(150vmax at calc(100% - 3rem) 2.2rem); visibility: visible; transition: clip-path 0.8s var(--ease), visibility 0s; }
+.mobile-links { display: grid; gap: 0.2rem; width: min(560px, 100%); margin-inline: auto; }
+.mobile-links a {
+  display: flex; align-items: baseline; gap: 1rem;
+  padding: 0.5rem 0; border-bottom: 1px solid var(--line);
+  font: 700 clamp(1.5rem, 6.5vw, 2.1rem)/1.15 var(--font-display); letter-spacing: -0.03em; color: var(--text);
+  opacity: 0; transform: translateY(24px);
+  transition: opacity 0.5s, transform 0.6s var(--ease), color 0.2s;
+}
+.mobile-links a small { font: 500 0.7rem/1 var(--font-mono); color: var(--text-3); letter-spacing: 0.1em; }
+.mobile-links a:hover, .mobile-links a:focus-visible { color: var(--acc-ink); }
+.mobile-menu.is-open .mobile-links a { opacity: 1; transform: none; transition-delay: calc(var(--i) * 45ms + 200ms); }
+.mobile-foot { width: min(560px, 100%); margin: 1.75rem auto 0; display: flex; gap: 0.6rem; flex-wrap: wrap; }
+
+@media (min-width: 640px) { .nav-actions .nav-cta { display: inline-flex; } }
+@media (min-width: 1100px) {
+  .nav { display: block; }
+  .menu-btn { display: none; }
+}
+
+/* inline SVG sprite icons */
+.ico { width: 1.15em; height: 1.15em; flex: none; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
+.ico-fill { fill: currentColor; stroke: none; }
+
+/* ─────────────── 5. BUTTONS & CHIPS ─────────────── */
+.btn {
+  --pad-y: 0.9rem; --pad-x: 1.5rem;
+  position: relative; isolation: isolate; overflow: hidden;
+  display: inline-flex; align-items: center; justify-content: center; gap: 0.6rem;
+  padding: var(--pad-y) var(--pad-x); min-height: 48px;
+  border-radius: 999px; border: 1px solid var(--line-2);
+  font: 600 0.95rem/1.1 var(--font-body); letter-spacing: -0.005em;
+  color: var(--text); background: var(--surface);
+  transition: transform 0.45s var(--spring), border-color 0.3s, background 0.3s, box-shadow 0.4s, color 0.3s;
+  white-space: nowrap; -webkit-tap-highlight-color: transparent;
+}
+.btn .ico { width: 17px; height: 17px; transition: transform 0.4s var(--ease); }
+.btn:hover { border-color: rgb(var(--acc-rgb) / 0.7); background: rgb(var(--acc-rgb) / 0.12); }
+.btn:active { transform: scale(0.97); }
+.btn:hover .i-arrow { transform: translateX(4px); }
+.btn:hover .i-up-right { transform: translate(3px, -3px); }
+.btn:hover .i-down { transform: translateY(3px); }
+
+.btn-primary {
+  color: #fff; border-color: transparent;
+  background: var(--btn-grad); background-size: 200% 100%;
+  box-shadow: 0 10px 30px -10px rgb(192 38 211 / 0.7), inset 0 1px 0 rgb(255 255 255 / 0.25);
+}
+.btn-primary:hover { background: var(--btn-grad); background-size: 200% 100%; background-position: 100% 0; border-color: transparent; box-shadow: 0 16px 40px -10px rgb(244 63 122 / 0.75), inset 0 1px 0 rgb(255 255 255 / 0.3); }
+.btn-primary::after {
+  content: ""; position: absolute; inset: 0; z-index: -1;
+  background: linear-gradient(105deg, transparent 35%, rgb(255 255 255 / 0.35) 50%, transparent 65%);
+  transform: translateX(-120%);
+}
+.btn-primary:hover::after { transform: translateX(120%); transition: transform 0.9s var(--ease); }
+
+.btn-sm { --pad-y: 0.55rem; --pad-x: 1.05rem; min-height: 40px; font-size: 0.85rem; }
+.btn-block { width: 100%; }
+
+.chip {
+  display: inline-flex; align-items: center; gap: 0.45rem;
+  padding: 0.32rem 0.8rem; border-radius: 999px;
+  font: 500 0.76rem/1.4 var(--font-mono); letter-spacing: 0.01em;
+  color: var(--text-2); background: var(--surface); border: 1px solid var(--line);
+  transition: color 0.25s, border-color 0.25s, background 0.25s, transform 0.35s var(--spring);
+}
+.chip:hover { color: var(--acc-ink); border-color: rgb(var(--acc-rgb) / 0.55); background: rgb(var(--acc-rgb) / 0.1); transform: translateY(-2px); }
+.chip-accent { color: var(--acc-ink); border-color: rgb(var(--acc-rgb) / 0.4); background: rgb(var(--acc-rgb) / 0.1); }
+.chip-gold { --acc: var(--c-amber); --acc-rgb: 251 191 36; }
+.chip-row { display: flex; flex-wrap: wrap; gap: 0.5rem; }
+
+.status {
+  display: inline-flex; align-items: center; gap: 0.5rem;
+  padding: 0.3rem 0.75rem; border-radius: 999px;
+  font: 500 0.7rem/1.4 var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase;
+  color: var(--acc-ink); background: rgb(var(--acc-rgb) / 0.12); border: 1px solid rgb(var(--acc-rgb) / 0.35);
+  white-space: nowrap;
+}
+.status .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--acc); box-shadow: 0 0 0 0 rgb(var(--acc-rgb) / 0.7); animation: ping 2s infinite; }
+.status.is-done .dot { animation: none; box-shadow: none; }
+@keyframes ping { 70% { box-shadow: 0 0 0 9px rgb(var(--acc-rgb) / 0); } 100% { box-shadow: 0 0 0 0 rgb(var(--acc-rgb) / 0); } }
+
+.link-arrow { display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 600; color: var(--acc-ink); }
+.link-arrow .ico { width: 16px; height: 16px; transition: transform 0.35s var(--ease); }
+.link-arrow:hover .ico { transform: translateX(5px); }
+
+/* ─────────────── 6. CARDS ─────────────── */
+.card {
+  position: relative; isolation: isolate;
+  background: var(--surface);
+  border: 1px solid var(--line);
+  border-radius: var(--r-lg);
+  padding: clamp(1.25rem, 3vw, 2rem);
+  transition: transform 0.45s var(--ease), border-color 0.4s, box-shadow 0.5s, background 0.4s;
+}
+[data-theme="light"] .card { box-shadow: 0 1px 0 rgb(255 255 255 / 0.8) inset, 0 12px 34px -22px rgb(60 40 140 / 0.35); }
+
+/* cursor-following spotlight + gradient border (vars are set by main.js) */
+.card::before {
+  content: ""; position: absolute; inset: 0; z-index: -1; border-radius: inherit; pointer-events: none;
+  background: radial-gradient(460px circle at var(--mx, 50%) var(--my, 0%), rgb(var(--acc-rgb) / 0.16), transparent 55%);
+  opacity: 0; transition: opacity 0.4s;
+}
+.card::after {
+  content: ""; position: absolute; inset: -1px; border-radius: inherit; padding: 1px; pointer-events: none;
+  background: radial-gradient(380px circle at var(--mx, 50%) var(--my, 0%), rgb(var(--acc-rgb) / 0.95), transparent 60%);
+  -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
+  -webkit-mask-composite: xor; mask-composite: exclude;
+  opacity: 0; transition: opacity 0.4s;
+}
+@media (hover: hover) {
+  .card:hover { border-color: transparent; box-shadow: var(--shadow); }
+  .card:hover::before, .card:hover::after { opacity: 1; }
+}
+.card[data-tilt] { transform-style: preserve-3d; will-change: transform; }
+
+.icon-tile {
+  width: 52px; height: 52px; border-radius: 16px; flex: none;
+  display: grid; place-items: center; font-size: 1.55rem; line-height: 1;
+  background: linear-gradient(145deg, rgb(var(--acc-rgb) / 0.28), rgb(var(--acc-rgb) / 0.06));
+  border: 1px solid rgb(var(--acc-rgb) / 0.4);
+  box-shadow: 0 8px 24px -10px rgb(var(--acc-rgb) / 0.7);
+}
+
+/* ─────────────── 7. REVEAL MOTION ─────────────── */
+.js [data-reveal] {
+  opacity: 0;
+  transition: opacity 0.9s var(--ease), transform 0.9s var(--ease), filter 0.9s var(--ease);
+  transition-delay: calc(var(--i, 0) * 80ms);
+}
+.js [data-reveal="up"], .js [data-reveal=""] { transform: translateY(36px); }
+.js [data-reveal="left"]  { transform: translateX(-48px); }
+.js [data-reveal="right"] { transform: translateX(48px); }
+.js [data-reveal="scale"] { transform: scale(0.9); }
+.js [data-reveal="blur"]  { transform: translateY(24px) scale(0.98); filter: blur(14px); }
+.js [data-reveal="flip"]  { transform: perspective(900px) rotateX(18deg) translateY(30px); transform-origin: 50% 100%; }
+.js [data-reveal].is-in { opacity: 1; transform: none; filter: none; }
+/* once the entrance is finished, hand the element back to hover / tilt transitions */
+.js [data-reveal].is-in.is-done { transition: transform 0.45s var(--ease), border-color 0.4s, box-shadow 0.5s, background 0.4s; transition-delay: 0s; }
+.reveal-fallback [data-reveal], .reveal-fallback .wi, .reveal-fallback .eyebrow::before { opacity: 1 !important; transform: none !important; filter: none !important; }
+
+/* ─────────────── 8. UTILITIES ─────────────── */
+.scroll-progress {
+  position: fixed; top: 0; left: 0; right: 0; height: 3px; z-index: 200;
+  background: var(--grad); transform-origin: left; transform: scaleX(var(--sp, 0));
+  box-shadow: 0 0 12px rgb(139 92 246 / 0.8); pointer-events: none;
+}
+
+.cursor-glow {
+  position: fixed; top: 0; left: 0; width: 520px; height: 520px; margin: -260px 0 0 -260px;
+  border-radius: 50%; pointer-events: none; z-index: 0;
+  background: radial-gradient(circle, rgb(139 92 246 / 0.16), rgb(34 211 238 / 0.06) 40%, transparent 68%);
+  opacity: 0; transition: opacity 0.5s; will-change: transform;
+}
+.cursor-glow.is-on { opacity: 1; }
+[data-theme="light"] .cursor-glow { background: radial-gradient(circle, rgb(124 58 237 / 0.12), rgb(8 145 178 / 0.05) 40%, transparent 68%); }
+main, footer, section { position: relative; z-index: 1; }
+
+.to-top {
+  position: fixed; z-index: 90;
+  right: max(1rem, env(safe-area-inset-right)); bottom: max(1rem, env(safe-area-inset-bottom));
+  width: 48px; height: 48px; border-radius: 50%;
+  display: grid; place-items: center; color: var(--text);
+  background: var(--glass); border: 1px solid var(--line-2);
+  -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px);
+  opacity: 0; transform: translateY(20px) scale(0.8); pointer-events: none;
+  transition: opacity 0.35s, transform 0.5s var(--spring), border-color 0.3s;
+}
+.to-top .ico { width: 18px; height: 18px; }
+.to-top.is-visible { opacity: 1; transform: none; pointer-events: auto; }
+.to-top:hover { border-color: var(--c-violet); transform: translateY(-4px); }
+
+.toast {
+  position: fixed; left: 50%; bottom: max(1.25rem, env(safe-area-inset-bottom)); z-index: 400;
+  transform: translate(-50%, 30px); opacity: 0; pointer-events: none;
+  display: inline-flex; align-items: center; gap: 0.55rem;
+  padding: 0.7rem 1.1rem; border-radius: 999px;
+  background: var(--text); color: var(--bg); font-weight: 600; font-size: 0.9rem;
+  transition: opacity 0.3s, transform 0.5s var(--spring);
+}
+.toast .ico { width: 16px; height: 16px; stroke-width: 3; }
+.toast.is-on { opacity: 1; transform: translate(-50%, 0); }
+
+.sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
+.no-js .js-only { display: none; }
+
+/* =====================================================================
+   9. HOME PAGE SECTIONS
+   ===================================================================== */
+
+/* ─────────────── HERO ─────────────── */
+@property --ang { syntax: "<angle>"; inherits: false; initial-value: 0deg; }
+
+.hero {
+  position: relative; display: flex; align-items: center;
+  min-height: 100vh; min-height: 100svh;
+  padding: calc(var(--header-h) + 2.5rem) 0 clamp(3rem, 7vw, 5rem);
+  overflow: hidden;
+}
+.hero-bg { position: absolute; inset: 0; z-index: -1; pointer-events: none; }
+.hero-grid {
+  position: absolute; inset: 0;
+  background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px);
+  background-size: 56px 56px;
+  -webkit-mask-image: radial-gradient(ellipse 75% 65% at 50% 38%, #000 25%, transparent 78%);
+  mask-image: radial-gradient(ellipse 75% 65% at 50% 38%, #000 25%, transparent 78%);
+}
+.orb { position: absolute; border-radius: 50%; will-change: transform; }
+.orb-1 { width: 56vmax; height: 56vmax; left: -18vmax; top: -22vmax; background: radial-gradient(circle, rgb(139 92 246 / 0.55), transparent 62%); animation: drift1 20s ease-in-out infinite; }
+.orb-2 { width: 48vmax; height: 48vmax; right: -16vmax; top: -6vmax; background: radial-gradient(circle, rgb(34 211 238 / 0.40), transparent 62%); animation: drift2 24s ease-in-out infinite; }
+.orb-3 { width: 44vmax; height: 44vmax; left: 20%; bottom: -26vmax; background: radial-gradient(circle, rgb(255 77 141 / 0.40), transparent 62%); animation: drift3 22s ease-in-out infinite; }
+[data-theme="light"] .orb { opacity: 0.55; }
+@keyframes drift1 { 50% { transform: translate(9vmax, 7vmax) scale(1.12); } }
+@keyframes drift2 { 50% { transform: translate(-8vmax, 9vmax) scale(0.92); } }
+@keyframes drift3 { 50% { transform: translate(6vmax, -6vmax) scale(1.1); } }
+
+.hero-inner { display: grid; gap: clamp(2.5rem, 6vw, 4rem); align-items: center; }
+
+.hero-badge {
+  display: inline-flex; align-items: center; gap: 0.65rem; max-width: 100%;
+  padding: 0.5rem 1rem 0.5rem 0.8rem; border-radius: 999px;
+  font: 500 0.78rem/1.35 var(--font-mono); color: var(--text-2);
+  background: var(--surface); border: 1px solid var(--line-2);
+}
+.hero-badge .dot { flex: none; width: 9px; height: 9px; border-radius: 50%; background: var(--c-lime); box-shadow: 0 0 0 0 rgb(163 230 53 / 0.7); animation: ping 2s infinite; }
+[data-theme="light"] .hero-badge .dot { background: #65a30d; }
+
+.hero-name {
+  margin: 1.25rem 0 0.4rem;
+  font-size: clamp(3.6rem, 13vw, 8.4rem); font-weight: 800; line-height: 0.94; letter-spacing: -0.055em;
+}
+.hero-name .line { display: block; overflow: hidden; padding: 0.04em 0.08em 0.16em 0; margin-bottom: -0.1em; }
+.hero-name .line > span { display: inline-block; animation: lineUp 1.1s var(--ease) backwards; }
+.hero-name .line:nth-child(2) > span { animation-delay: 0.12s; }
+@keyframes lineUp { from { transform: translateY(105%) rotate(4deg); filter: blur(10px); } }
+
+.hero-name .line > .grad-text, .page-title .line > .grad-text { animation: lineUp 1.1s var(--ease) 0.12s backwards, gradShift 9s linear 1.2s infinite; }
+
+.hero-role {
+  display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.4rem 0.7rem;
+  font: 600 clamp(1.15rem, 2.8vw, 1.75rem)/1.3 var(--font-display); letter-spacing: -0.02em; color: var(--text);
+}
+.typed { color: var(--c-pink); min-height: 1.3em; }
+[data-theme="light"] .typed { color: var(--c-pink); }
+.caret { display: inline-block; width: 3px; height: 1.05em; margin-left: 3px; transform: translateY(0.15em); background: var(--c-pink); animation: blink 1s steps(1) infinite; }
+@keyframes blink { 50% { opacity: 0; } }
+
+.hero-bio { margin-top: 1.4rem; max-width: 56ch; font-size: clamp(1.02rem, 1.7vw, 1.18rem); color: var(--text-2); }
+.hero-actions { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 2rem; }
+.hero-social { display: flex; align-items: center; gap: 0.6rem; margin-top: 1.75rem; }
+.hero-social span { font: 500 0.75rem var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-3); margin-right: 0.35rem; }
+
+.hero-copy > * { animation: fadeUp 0.9s var(--ease) backwards; }
+.hero-copy > .hero-badge { animation-delay: 0.05s; }
+.hero-copy > .hero-role { animation-delay: 0.45s; }
+.hero-copy > .hero-bio { animation-delay: 0.6s; }
+.hero-copy > .hero-actions { animation-delay: 0.75s; }
+.hero-copy > .hero-social { animation-delay: 0.9s; }
+@keyframes fadeUp { from { opacity: 0; transform: translateY(26px); } }
+
+.hero-visual { position: relative; display: grid; place-items: center; animation: fadeUp 1.2s var(--ease) 0.3s backwards; }
+.photo-frame { position: relative; width: min(340px, 74vw); aspect-ratio: 4 / 5; }
+.photo-frame::before { /* glow */
+  content: ""; position: absolute; inset: 8% 4% -6%; z-index: 0; border-radius: 50%;
+  background: var(--grad); filter: blur(46px); opacity: 0.55;
+}
+.photo-ring {
+  position: absolute; inset: -4px; z-index: 1; border-radius: 999px 999px 38px 38px;
+  background: conic-gradient(from var(--ang), var(--c-cyan), var(--c-violet), var(--c-pink), var(--c-amber), var(--c-cyan));
+  animation: spinAng 7s linear infinite;
+}
+@keyframes spinAng { to { --ang: 360deg; } }
+.photo-img {
+  position: relative; z-index: 2; width: 100%; height: 100%; object-fit: cover; object-position: 50% 16%;
+  border-radius: 999px 999px 34px 34px; background: var(--bg-3);
+}
+.float-chip {
+  position: absolute; z-index: 3; display: inline-flex; align-items: center; gap: 0.5rem;
+  padding: 0.55rem 0.9rem; border-radius: 14px;
+  font: 500 0.78rem/1 var(--font-mono); color: var(--text);
+  background: var(--glass); border: 1px solid var(--line-2); box-shadow: var(--shadow);
+  -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
+  translate: var(--tx, 0px) var(--ty, 0px);
+  transition: translate 0.5s var(--ease);
+  animation: bob 6s ease-in-out infinite;
+}
+.float-chip i { width: 8px; height: 8px; border-radius: 50%; background: var(--c); box-shadow: 0 0 10px var(--c); }
+.fc-1 { --c: var(--c-cyan);   top: 6%;  left: -7%; }
+.fc-2 { --c: var(--c-pink);   top: 32%; right: -9%; animation-delay: -1.5s; }
+.fc-3 { --c: var(--c-lime);   bottom: 24%; left: -10%; animation-delay: -3s; }
+.fc-4 { --c: var(--c-amber);  bottom: 5%; right: -3%; animation-delay: -4.5s; }
+@keyframes bob { 50% { transform: translateY(-12px); } }
+
+.scroll-cue {
+  position: absolute; left: 50%; bottom: 1.4rem; translate: -50% 0; display: none;
+  flex-direction: column; align-items: center; gap: 0.5rem;
+  font: 500 0.68rem var(--font-mono); letter-spacing: 0.2em; text-transform: uppercase; color: var(--text-3);
+}
+.scroll-cue i { width: 22px; height: 36px; border: 2px solid var(--line-2); border-radius: 14px; position: relative; }
+.scroll-cue i::after { content: ""; position: absolute; left: 50%; top: 6px; width: 3px; height: 7px; margin-left: -1.5px; border-radius: 3px; background: var(--c-cyan); animation: wheel 1.8s ease-in-out infinite; }
+@keyframes wheel { 0% { opacity: 0; transform: translateY(0); } 30% { opacity: 1; } 100% { opacity: 0; transform: translateY(12px); } }
+
+@media (min-width: 960px) {
+  .hero-inner { grid-template-columns: 1.3fr 0.8fr; }
+  .photo-frame { width: min(400px, 100%); }
+}
+@media (min-width: 960px) and (min-height: 700px) { .scroll-cue { display: flex; } }
+@media (max-width: 560px) {
+  .fc-1 { left: -3%; } .fc-2 { right: -4%; } .fc-3 { left: -4%; } .fc-4 { right: 0; }
+  .float-chip { padding: 0.45rem 0.7rem; font-size: 0.7rem; }
+  .hero-actions .btn { flex: 1 1 auto; }
+}
+
+/* ─────────────── STATS BAND ─────────────── */
+.stats { padding-block: 0 clamp(1rem, 3vw, 2rem); }
+.stats-grid {
+  display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px;
+  border-radius: var(--r-xl); overflow: hidden;
+  background: var(--line-2); border: 1px solid var(--line-2); box-shadow: var(--shadow);
+}
+.stat { position: relative; padding: clamp(1.4rem, 3.5vw, 2.2rem) 1rem; text-align: center; background: var(--bg-2); transition: background 0.4s; }
+.stat:hover { background: var(--bg-3); }
+.stat:last-child:nth-child(odd) { grid-column: 1 / -1; }
+.stat-num { font: 800 clamp(2.2rem, 5.2vw, 3.4rem)/1 var(--font-display); letter-spacing: -0.04em; font-variant-numeric: tabular-nums; }
+.stat-num.c1 { background-image: linear-gradient(120deg, var(--c-cyan), var(--c-violet)); }
+.stat-num.c2 { background-image: linear-gradient(120deg, var(--c-violet), var(--c-pink)); }
+.stat-num.c3 { background-image: linear-gradient(120deg, var(--c-pink), var(--c-amber)); }
+.stat-num.c4 { background-image: linear-gradient(120deg, var(--c-amber), var(--c-lime)); }
+.stat-num.c5 { background-image: linear-gradient(120deg, var(--c-lime), var(--c-cyan)); }
+.stat-num { -webkit-background-clip: text; background-clip: text; color: transparent; -webkit-text-fill-color: transparent; }
+.stat-label { margin-top: 0.6rem; font-size: 0.85rem; line-height: 1.45; color: var(--text-2); }
+@media (min-width: 900px) { .stats-grid { grid-template-columns: repeat(5, 1fr); } .stat:last-child:nth-child(odd) { grid-column: auto; } }
+
+/* ─────────────── ABOUT ─────────────── */
+.about-grid { display: grid; gap: clamp(2rem, 5vw, 4rem); }
+.about-text p { margin-bottom: 1.2rem; font-size: clamp(1rem, 1.5vw, 1.1rem); }
+.highlight { color: var(--text); font-weight: 500; background: linear-gradient(transparent 60%, rgb(var(--acc-rgb) / 0.35) 60%); padding: 0 0.15em; border-radius: 3px; }
+.about-cards { display: grid; gap: 1rem; align-content: start; }
+.fact { padding: 1.4rem 1.5rem; }
+.fact-label { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.7rem; font: 500 0.7rem/1 var(--font-mono); letter-spacing: 0.14em; text-transform: uppercase; color: var(--acc-ink); }
+.fact-label .ico { width: 14px; height: 14px; }
+.fact-value { font: 700 1.1rem/1.35 var(--font-display); color: var(--text); letter-spacing: -0.01em; }
+.fact-note { margin-top: 0.35rem; font-size: 0.9rem; color: var(--text-3); }
+.fact .chip-row { margin-top: 0.8rem; }
+.fact .chip-row:first-of-type:last-child { margin-top: 0; }
+@media (min-width: 640px) and (max-width: 959px) { .about-cards { grid-template-columns: 1fr 1fr; } .fact.span-2 { grid-column: 1 / -1; } }
+@media (min-width: 960px) { .about-grid { grid-template-columns: 1.1fr 0.9fr; align-items: start; } .about-copy { position: sticky; top: calc(var(--header-h) + 1.5rem); } }
+
+/* ─────────────── NOW ─────────────── */
+.now-grid { display: grid; gap: 1.25rem; }
+.now-label { font: 500 0.72rem/1 var(--font-mono); letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-3); margin: 1.25rem 0 0.35rem; }
+.now-name { font-size: clamp(1.7rem, 3.6vw, 2.5rem); font-weight: 800; }
+.now-type { margin-top: 0.35rem; font: 500 0.82rem/1.5 var(--font-mono); color: var(--acc-ink); }
+.now-sum { margin-top: 0.9rem; max-width: 58ch; }
+.now-main-grid { display: grid; gap: 2rem; margin-top: 1.5rem; }
+.progress { display: grid; gap: 1.1rem; align-content: start; }
+.progress-title { font: 500 0.72rem/1 var(--font-mono); letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-3); }
+.progress-row header { display: flex; justify-content: space-between; gap: 1rem; font-size: 0.9rem; margin-bottom: 0.45rem; color: var(--text); }
+.progress-row header b { font: 600 0.8rem var(--font-mono); color: var(--acc-ink); }
+.bar { height: 8px; border-radius: 8px; background: var(--surface-2); overflow: hidden; }
+.bar > i {
+  position: relative; display: block; height: 100%; width: 0; border-radius: inherit;
+  background: linear-gradient(90deg, var(--acc), var(--c-pink)); box-shadow: 0 0 14px rgb(var(--acc-rgb) / 0.6);
+  transition: width 1.6s var(--ease) 0.35s;
+}
+.bar > i::after { content: ""; position: absolute; inset: 0; background: linear-gradient(100deg, transparent 30%, rgb(255 255 255 / 0.55) 50%, transparent 70%); background-size: 200% 100%; animation: shimmer 2.6s linear infinite; }
+@keyframes shimmer { from { background-position: 200% 0; } to { background-position: -200% 0; } }
+.is-in .bar > i, .no-js .bar > i { width: var(--v); }
+@media (min-width: 720px) { .now-main-grid { grid-template-columns: 1.2fr 1fr; gap: 2.5rem; } }
+@media (min-width: 960px) { .now-grid { grid-template-columns: 1fr 1fr; } .now-main { grid-column: 1 / -1; } }
+
+/* ─────────────── TIMELINE ─────────────── */
+.timeline { --tl-date: 190px; position: relative; display: grid; gap: 1.5rem; }
+.timeline::before, .timeline::after { content: ""; position: absolute; left: 7px; top: 12px; bottom: 12px; width: 2px; border-radius: 2px; }
+.timeline::before { background: var(--line-2); }
+.timeline::after { background: linear-gradient(var(--c-cyan), var(--c-violet) 55%, var(--c-pink)); transform-origin: top; transform: scaleY(var(--p, 0)); box-shadow: 0 0 14px rgb(139 92 246 / 0.8); }
+.tl-item { position: relative; display: grid; gap: 0.5rem; padding-left: 2.2rem; }
+.tl-dot { position: absolute; left: 0; top: 0.35rem; width: 16px; height: 16px; border-radius: 50%; background: var(--bg); border: 3px solid var(--line-2); transition: border-color 0.5s, box-shadow 0.5s, transform 0.6s var(--spring); }
+.tl-item.is-in .tl-dot { border-color: var(--acc); box-shadow: 0 0 0 5px rgb(var(--acc-rgb) / 0.2), 0 0 18px rgb(var(--acc-rgb) / 0.8); transform: scale(1.1); }
+.tl-date { font: 500 0.8rem/1.5 var(--font-mono); color: var(--acc-ink); letter-spacing: 0.02em; padding-top: 0.15rem; }
+.tl-title { font-size: clamp(1.2rem, 2.6vw, 1.55rem); font-weight: 700; }
+.tl-org { margin-top: 0.3rem; font-size: 0.92rem; color: var(--text-3); }
+.tl-list { margin-top: 1rem; display: grid; gap: 0.6rem; }
+.tl-list li { position: relative; padding-left: 1.3rem; font-size: 0.98rem; }
+.tl-list li::before { content: ""; position: absolute; left: 0; top: 0.72em; width: 7px; height: 7px; border-radius: 2px; transform: rotate(45deg); background: var(--acc); }
+.tl-card .btn { margin-top: 1.25rem; }
+@media (min-width: 860px) {
+  .tl-item { grid-template-columns: var(--tl-date) 1fr; gap: 0 3rem; padding-left: 0; }
+  .timeline::before, .timeline::after { left: calc(var(--tl-date) + 1.5rem - 1px); }
+  .tl-dot { left: calc(var(--tl-date) + 1.5rem - 8px); }
+  .tl-date { text-align: right; padding-top: 1.75rem; }
+}
+
+/* ─────────────── PROJECTS (home) ─────────────── */
+.proj-feature { display: grid; gap: 2rem; padding: clamp(1.4rem, 4vw, 3rem); overflow: hidden; }
+.proj-feature::selection { background: rgb(var(--acc-rgb) / 0.3); }
+.proj-head { display: flex; align-items: center; flex-wrap: wrap; gap: 0.9rem 1.1rem; margin-bottom: 1.1rem; }
+.proj-title { font-size: clamp(1.6rem, 3.6vw, 2.5rem); font-weight: 800; }
+.proj-feature .proj-title { font-size: clamp(2rem, 5vw, 3.2rem); }
+.proj-mini .proj-title { font-size: clamp(1.35rem, 2.4vw, 1.75rem); }
+.proj-desc { max-width: 62ch; }
+.proj-points { display: grid; gap: 0.55rem; margin: 1.25rem 0; }
+.proj-points li { position: relative; padding-left: 1.5rem; font-size: 0.96rem; }
+.proj-points li::before { content: ""; position: absolute; left: 0; top: 0.62em; width: 8px; height: 8px; border-radius: 50%; background: var(--acc); box-shadow: 0 0 10px rgb(var(--acc-rgb) / 0.8); }
+.proj-actions { display: flex; flex-wrap: wrap; gap: 0.7rem; margin-top: 1.5rem; }
+.metrics { display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 0.8rem; align-content: center; }
+.metric { padding: 1.2rem 1rem; border-radius: var(--r); text-align: center; background: rgb(var(--acc-rgb) / 0.08); border: 1px solid rgb(var(--acc-rgb) / 0.25); transition: transform 0.4s var(--spring), background 0.3s; }
+.metric:hover { transform: translateY(-4px) scale(1.03); background: rgb(var(--acc-rgb) / 0.16); }
+.metric-val { font: 800 clamp(1.6rem, 3.4vw, 2.4rem)/1 var(--font-display); letter-spacing: -0.03em; color: var(--acc-ink); }
+.metric-val.sm { font-size: clamp(1.1rem, 2.4vw, 1.4rem); padding-block: 0.3rem; }
+.metric-label { margin-top: 0.5rem; font: 500 0.68rem/1.3 var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-3); }
+.proj-grid { display: grid; gap: 1.25rem; margin-top: 1.25rem; }
+.proj-mini { display: flex; flex-direction: column; }
+.proj-mini .proj-desc { flex: 1; }
+.proj-cta {
+  display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; margin-top: 1.25rem;
+  padding: clamp(1.4rem, 4vw, 2.2rem) clamp(1.4rem, 4vw, 2.6rem); border-radius: var(--r-lg);
+  background: linear-gradient(120deg, rgb(139 92 246 / 0.22), rgb(255 77 141 / 0.18) 60%, rgb(34 211 238 / 0.18));
+  border: 1px solid var(--line-2); transition: transform 0.5s var(--ease), border-color 0.3s, box-shadow 0.5s;
+}
+.proj-cta:hover { transform: translateY(-4px); border-color: var(--c-pink); box-shadow: 0 24px 50px -24px rgb(255 77 141 / 0.6); }
+.proj-cta strong { display: block; font: 700 clamp(1.2rem, 2.8vw, 1.7rem)/1.2 var(--font-display); letter-spacing: -0.02em; }
+.proj-cta span { color: var(--text-2); font-size: 0.95rem; }
+.go { flex: none; width: 56px; height: 56px; display: grid; place-items: center; border-radius: 50%; color: #fff; background: var(--btn-grad); transition: transform 0.5s var(--spring); }
+.proj-cta:hover .go, .blog-card:hover .go { transform: rotate(-45deg) scale(1.1); }
+.go .ico { width: 22px; height: 22px; }
+@media (min-width: 900px) { .proj-feature { grid-template-columns: 1.6fr 1fr; gap: 3rem; } .metrics { grid-template-columns: 1fr; } }
