+}
+
+.proj-stack { display: grid; gap: 1.5rem; }
+.proj { display: grid; gap: 1.5rem; padding: clamp(1.4rem, 3.5vw, 2.5rem); border-top: 2px solid rgb(var(--acc-rgb) / 0.75); scroll-margin-top: calc(var(--header-h) + 1rem); }
