+.preview-label { margin-top: 0.25rem; font: 500 0.72rem/1 var(--font-mono); letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-3); }
+.shots { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr)); gap: 0.85rem; padding: 1rem 0 0.25rem; }
+.shot { position: relative; display: block; width: 100%; aspect-ratio: 16 / 10; border-radius: var(--r); overflow: hidden; background: var(--bg-3); border: 1px solid var(--line-2); cursor: zoom-in; transition: border-color 0.3s, transform 0.5s var(--ease); }
+.shot img { width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: transform 0.8s var(--ease), opacity 0.6s; }
+.shot img.is-loaded { opacity: 1; }
