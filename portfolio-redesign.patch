+/* =====================================================================
+   10. INNER PAGES — projects.html & blog.html
+   ===================================================================== */
+.page-hero { position: relative; overflow: hidden; padding: calc(var(--header-h) + clamp(2.5rem, 7vw, 5rem)) 0 clamp(2rem, 5vw, 3.5rem); }
