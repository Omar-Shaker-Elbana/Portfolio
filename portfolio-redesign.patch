+  padding: clamp(3rem, 9vw, 6.5rem) clamp(1.25rem, 5vw, 4rem); border-radius: var(--r-xl);
+  background:
+    radial-gradient(520px 340px at 12% 0%, rgb(139 92 246 / 0.45), transparent 65%),
