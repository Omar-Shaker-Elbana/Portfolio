+.email-pill a { display: inline-flex; align-items: center; gap: 0.6rem; padding: 0.85rem 1.25rem; min-height: 48px; font: 500 0.9rem var(--font-mono); color: var(--text); min-width: 0; overflow-wrap: anywhere; transition: background 0.25s; }
