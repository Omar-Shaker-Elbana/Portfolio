+.page-stat b { display: block; font: 800 clamp(2rem, 4.5vw, 3rem)/1 var(--font-display); letter-spacing: -0.04em; background-image: var(--grad); -webkit-background-clip: text; background-clip: text; color: transparent; -webkit-text-fill-color: transparent; }
+.page-stat span { display: block; margin-top: 0.4rem; font: 500 0.72rem/1.3 var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-3); }
+
+/* filter pills */
+.filter-bar { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.75rem 1.5rem; margin-bottom: 1.75rem; }
+.filters { display: flex; gap: 0.55rem; overflow-x: auto; padding: 0.25rem 0.15rem; scrollbar-width: none; -webkit-overflow-scrolling: touch; scroll-snap-type: x proximity; max-width: 100%; }
+.filters::-webkit-scrollbar { display: none; }
+.filter {
+  flex: none; scroll-snap-align: start; min-height: 42px; padding: 0.55rem 1.1rem; border-radius: 999px;
+  font: 500 0.82rem/1 var(--font-mono); letter-spacing: 0.01em; color: var(--text-2);
+  background: var(--surface); border: 1px solid var(--line-2);
+  transition: color 0.25s, background 0.25s, border-color 0.25s, transform 0.4s var(--spring);
+}
+.filter:hover { color: var(--text); border-color: var(--c-violet); transform: translateY(-2px); }
+.filter[aria-pressed="true"] { color: #fff; border-color: transparent; background: var(--btn-grad); box-shadow: 0 8px 24px -10px rgb(192 38 211 / 0.8); }
+.result-count { font: 500 0.78rem var(--font-mono); color: var(--text-3); }
+
+.proj-layout { display: grid; gap: 2rem; align-items: start; }
+.rail { display: none; }
+.rail-title { margin-bottom: 1rem; font: 500 0.7rem/1 var(--font-mono); letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-3); }
+.rail ol { display: grid; gap: 0.2rem; position: relative; }
+.rail a { position: relative; display: flex; align-items: center; gap: 0.8rem; padding: 0.6rem 0.8rem; border-radius: 12px; font-size: 0.88rem; line-height: 1.3; color: var(--text-3); transition: color 0.25s, background 0.25s; }
