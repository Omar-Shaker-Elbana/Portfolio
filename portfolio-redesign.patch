+@keyframes filterIn { from { opacity: 0; transform: translateY(24px) scale(0.98); } }
+.proj-top { display: flex; align-items: flex-start; justify-content: space-between; flex-wrap: wrap; gap: 1rem; }
+.proj-id { display: flex; align-items: center; gap: 1rem; min-width: 0; }
