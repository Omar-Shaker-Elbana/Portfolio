+.lb-count { font: 500 0.8rem var(--font-mono); letter-spacing: 0.1em; color: rgb(255 255 255 / 0.7); }
+.lb-stage { position: relative; display: grid; place-items: center; min-height: 0; padding: 0.5rem clamp(0.5rem, 6vw, 5rem); touch-action: pan-y; }
+.lb-img { max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain; border-radius: 12px; box-shadow: 0 30px 80px rgb(0 0 0 / 0.6); transition: opacity 0.25s, transform 0.35s var(--ease); user-select: none; -webkit-user-drag: none; }
+.lb-img.is-out-l { opacity: 0; transform: translateX(-40px); }
+.lb-img.is-out-r { opacity: 0; transform: translateX(40px); }
+.lb-nav { position: absolute; top: 50%; translate: 0 -50%; z-index: 2; width: 48px; height: 48px; border-radius: 50%; display: grid; place-items: center; color: #fff; background: rgb(255 255 255 / 0.12); border: 1px solid rgb(255 255 255 / 0.22); transition: background 0.25s, transform 0.4s var(--spring), opacity 0.25s; }
+.lb-nav:hover { background: rgb(255 255 255 / 0.24); transform: scale(1.1); }
+.lb-nav .ico { width: 20px; height: 20px; }
+.lb-prev { left: max(0.6rem, env(safe-area-inset-left)); }
+.lb-next { right: max(0.6rem, env(safe-area-inset-right)); }
+.lb-nav[disabled] { opacity: 0.25; pointer-events: none; }
+.lightbox:not(.is-multi) .lb-nav { display: none; }
+.lb-cap { padding: 0.5rem 1.25rem max(1.25rem, env(safe-area-inset-bottom)); text-align: center; font-size: 0.9rem; color: rgb(255 255 255 / 0.75); }
+.lb-close { width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center; color: #fff; background: rgb(255 255 255 / 0.12); border: 1px solid rgb(255 255 255 / 0.22); transition: background 0.25s, transform 0.4s var(--spring); }
+.lb-close:hover { background: rgb(255 255 255 / 0.24); transform: rotate(90deg); }
+.lb-close .ico { width: 18px; height: 18px; }
+
+.pdf-dialog { margin: auto; width: min(1100px, 96vw); height: min(92vh, 940px); height: min(92dvh, 940px); padding: 0; border: 1px solid var(--line-2); border-radius: var(--r-lg); background: var(--bg-2); overflow: hidden; box-shadow: 0 40px 100px rgb(0 0 0 / 0.6); }
+.pdf-dialog[open] { display: flex; flex-direction: column; animation: dlgIn 0.45s var(--ease); }
+.pdf-head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.8rem 1rem 0.8rem 1.4rem; border-bottom: 1px solid var(--line); background: var(--surface); }
+.pdf-head h2 { font: 600 1rem/1.3 var(--font-display); letter-spacing: -0.01em; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.pdf-head div { display: flex; align-items: center; gap: 0.5rem; flex: none; }
+.pdf-dialog iframe { flex: 1; width: 100%; background: #fff; }
+@keyframes dlgIn { from { opacity: 0; transform: scale(0.97); } }
+
+/* =====================================================================
+   11. MOTION PREFERENCES & SMALL-SCREEN SAFETY NET
+   ===================================================================== */
+@media (prefers-reduced-motion: reduce) {
+  *, *::before, *::after { animation-duration: 0.001ms !important; animation-iteration-count: 1 !important; transition-duration: 0.001ms !important; transition-delay: 0s !important; scroll-behavior: auto !important; }
+  .js [data-reveal] { opacity: 1; transform: none; filter: none; }
+  .wi { transform: none; }
+  .marquee { -webkit-mask-image: none; mask-image: none; overflow-x: auto; }
+  .cursor-glow { display: none; }
+  .orb { animation: none; }
+}
+
+@media (max-width: 380px) {
+  :root { --gutter: 1rem; }
+  .btn { --pad-x: 1.15rem; }
+  .hero-actions .btn { width: 100%; }
+}
+
+@media (hover: none) {
+  .card[data-tilt] { transform: none !important; }
+}
+
+@media print {
+  .site-header, .mobile-menu, .scroll-progress, .cursor-glow, .to-top, .hero-bg { display: none !important; }
+  body { background: #fff; color: #000; }
+  .js [data-reveal], .wi { opacity: 1 !important; transform: none !important; }
+}
