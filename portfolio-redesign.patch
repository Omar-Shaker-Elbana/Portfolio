+}
+[data-theme="light"] .contact-panel { background: radial-gradient(520px 340px at 12% 0%, rgb(124 58 237 / 0.22), transparent 65%), radial-gradient(520px 340px at 92% 100%, rgb(219 39 119 / 0.18), transparent 65%), radial-gradient(420px 300px at 80% 0%, rgb(8 145 178 / 0.16), transparent 65%), var(--bg-2); }
+.contact-panel .eyebrow { justify-content: center; }
+.contact-title { font-size: clamp(2.6rem, 9vw, 6rem); font-weight: 800; letter-spacing: -0.045em; line-height: 0.98; margin: 1.1rem 0 1.2rem; }
