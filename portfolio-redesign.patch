+.contact-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.8rem; margin-top: 2.25rem; }
+.email-pill { display: inline-flex; align-items: stretch; max-width: 100%; border-radius: 999px; overflow: hidden; border: 1px solid var(--line-2); background: var(--surface-2); }
